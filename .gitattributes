# The device is Linux and CI is Linux. CRLF in a shell script produces
# "bad interpreter: /usr/bin/env bash^M" — normalise everything to LF on commit
# regardless of the checkout platform.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.service text eol=lf
*.conf    text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.stl binary
*.3mf binary
